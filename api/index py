REGEX = re.compile(
    r"^[A-Z]{2}\s?\d{1,2}\s?[A-Z]{1,3}\s?\d{4}$|^[A-Z]{2}\s?\d{1,2}\s?BH\s?\d{4}$", re.I
)
REGEX_STRIP = re.compile(r"[\s-]+")


def normalize(n):
    return REGEX_STRIP.sub("", n or "").upper()


def valid_reg(n):
    return bool(REGEX.match((n or "").strip()))


